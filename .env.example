# PostgreSQL connection string. For Neon, use the *pooled* connection string
# (host contains "-pooler") and keep ?sslmode=require.
DATABASE_URL="postgresql://user:password@localhost:5432/mindscroll"

# Random 32+ character secret used to hash session tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Shared secret that protects /api/cron/ingest. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-another-random-string"
